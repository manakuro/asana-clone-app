{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.0",
    "npm": "please use pnpm",
    "yarn": "please use pnpm"
  },
  "type": "module",
  "scripts": {
    "prepare": "pnpm chakra:typegen",
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 8080",
    "start:local": "pnpm build && pnpm start",
    "cz": "git-cz",
    "lint": "biome check src",
    "lint:fix": "biome check --write --unsafe src",
    "test": "vitest",
    "test:ci": "vitest",
    "test:unit": "vitest --project=unit",
    "test:integration": "vitest --project=integration",
    "test:storybook": "vitest --project=storybook",
    "tsc": "tsc",
    "tsc:scripts": "tsc --p ./scripts/",
    "codegen": "pnpm codegen:download && graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm codegen:download && graphql-codegen --config codegen.ts --watch",
    "codegen:download": "env-cmd -f ./.env.local tsx scripts/codegen/download.ts",
    "codegen:prod": "pnpm codegen:download:prod && graphql-codegen",
    "codegen:download:prod": "echo ENV_JSON > ./env.json && env-cmd -f ./.env.json npx tsx scripts/codegen/download.ts",
    "codegen:ci": "graphql-codegen --config codegen.ts",
    "new:queryMock": "tsx ./scripts/new-query-mock.ts",
    "new:mutationMock": "tsx ./scripts/new-mutation-mock.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "chromatic:local": "env-cmd -f ./.env.local chromatic",
    "chakra:typegen": "npx @chakra-ui/cli typegen src/lib/chakra-ui/theme.ts"
  },
  "dependencies": {
    "@apollo/client": "4.2.7",
    "@chakra-ui/react": "3.36.1",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@emotion/react": "11.14.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@hello-pangea/dnd": "18.0.1",
    "@pdfslick/react": "4.0.0",
    "@react-hook/hover": "4.0.0",
    "@react-hook/latest": "1.0.3",
    "@react-hook/passive-layout-effect": "1.2.1",
    "date-fns": "4.4.0",
    "emoji-mart": "5.6.0",
    "emotion-theming": "11.0.0",
    "fast-deep-equal": "3.1.3",
    "firebase": "12.15.0",
    "formik": "2.4.9",
    "graphql": "17.0.2",
    "jotai": "2.20.2",
    "jotai-family": "1.0.2",
    "lodash-es": "4.18.1",
    "next": "16.2.10",
    "next-themes": "0.4.6",
    "prosemirror-commands": "1.7.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.7",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-suggest": "3.0.0",
    "prosemirror-transform": "1.12.0",
    "prosemirror-view": "1.41.8",
    "raf-schd": "4.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.6.0",
    "react-intersection-observer": "8.32.1",
    "react-player": "3.4.0",
    "resize-observer-polyfill": "1.5.1",
    "rxjs": "7.8.2",
    "shortid": "2.2.17",
    "subscriptions-transport-ws": "0.11.0",
    "use-prosemirror": "1.3.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/schema-ast": "6.1.0",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.1",
    "@mdx-js/react": "3.1.1",
    "@parcel/watcher": "2.6.0",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/addon-vitest": "10.5.3",
    "@storybook/nextjs-vite": "10.5.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/cross-spawn": "6.0.6",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.10.4",
    "@types/raf-schd": "4.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/shortid": "2.2.0",
    "@types/testing-library__jest-dom": "6.0.0",
    "@types/yargs": "17",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "biome-config": "workspace:*",
    "change-case": "5.4.4",
    "chromatic": "18.0.1",
    "consola": "3.4.2",
    "cross-env": "10.1.0",
    "cross-spawn": "7.0.6",
    "deepmerge": "4.3.1",
    "empty": "0.10.1",
    "env-cmd": "11.0.0",
    "fast-glob": "3.3.3",
    "happy-dom": "20.11.0",
    "hygen": "6.2.11",
    "inflection": "3.0.2",
    "mockdate": "3.0.5",
    "msw": "2.15.0",
    "msw-storybook-addon": "2.0.7",
    "playwright": "1.61.1",
    "storybook": "10.5.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "utility-types": "3.11.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yargs": "18.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
