{
  "name": "asana-clone-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check src",
    "lint:fix": "biome check --write --unsafe src",
    "codegen": "pnpm codegen:download && graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm codegen:download && graphql-codegen --config codegen.ts --watch",
    "codegen:download": "env-cmd -f ./.env.local tsx scripts/codegen/download.ts",
    "codegen:ci": "graphql-codegen --config codegen.ts",
    "env:pull": "eas env:pull --environment development",
    "tsc": "tsc"
  },
  "dependencies": {
    "@apollo/client": "4.2.12",
    "graphql-ws": "6.2.1",
    "@expo/ui": "57.0.13",
    "@react-native-firebase/app": "26.3.3",
    "@react-native-firebase/auth": "26.3.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "expo": "57.0.16",
    "expo-build-properties": "57.0.16",
    "expo-constants": "57.0.14",
    "expo-dev-client": "57.0.15",
    "expo-device": "57.0.1",
    "expo-font": "57.0.1",
    "expo-glass-effect": "57.0.1",
    "expo-image": "57.0.3",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.16",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.2",
    "expo-system-ui": "57.0.2",
    "expo-updates": "57.0.11",
    "expo-web-browser": "57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "graphql": "17.0.2",
    "crypto-hash": "4.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/schema-ast": "6.1.0",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.1",
    "@parcel/watcher": "2.6.0",
    "@biomejs/biome": "2.5.4",
    "@types/react": "19.2.17",
    "@types/node": "24.10.4",
    "env-cmd": "11.0.0",
    "consola": "3.4.2",
    "biome-config": "workspace:*",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "private": true
}
