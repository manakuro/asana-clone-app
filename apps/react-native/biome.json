{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "extends": ["./node_modules/biome-config/biome.json"],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/node_modules/",
      "!**/dist/",
      "!**/.expo/",
      "!**/web-build/",
      "!**/ios/",
      "!**/android/",
      "!expo-env.d.ts",
      "!**/src/graphql/documents/index.ts",
      "!**/src/graphql/enums/index.ts",
      "!**/src/graphql/types/index.ts",
      "!**/src/graphql/types/index.mock.ts",
      "!**/src/graphql/__schema__.graphql"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/app.config.js",
        "**/app.config.ts",
        "**/metro.config.js",
        "**/babel.config.js",
        "**/src/app/**/_layout.tsx",
        "**/src/app/**/index.tsx",
        "**/src/app/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
